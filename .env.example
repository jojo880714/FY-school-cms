# ──────────────────────────────────────────────────────────────
# 環境變數範本 — 複製成 .env.local 並填入真實值
# ⚠ .env / .env.local / .env.production 都已加入 .gitignore,不會 commit
# ──────────────────────────────────────────────────────────────

# ─── 前端(Vite)──────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── 後端 / 腳本 ─────────────────────────────────────────────
# Supabase service_role key(scripts/import-from-sheets.js --commit 需要)
# 來源:Supabase Studio → Project Settings → API → service_role secret
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Google Sheets API(scripts/import-from-sheets.js 讀 sheet)─
# 三選一,優先序由上而下:

# 選項 1:service account 金鑰檔(推薦,簡單)
# 1. 在 Google Cloud Console 建 service account + 下載 JSON 金鑰
# 2. 把該 sheet「檢視」分享給 SA email
# 3. JSON 檔放本機任意位置,把路徑填這
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# 選項 2:service account 金鑰內容(一行 JSON,避免管檔)
# 把整段 SA JSON 用 jq -c . 壓成一行貼進來
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# 選項 3:API key(僅讀「知道連結即可檢視」的 sheet)
# Google Cloud Console → API & Services → Credentials → Create API key
# GOOGLE_SHEETS_API_KEY=AIza...
